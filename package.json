{
  "name": "keiro-runtime-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Docs for keiro runtime",
  "type": "module",
  "scripts": {
    "dev": "bun run copy-fonts && vite dev --host 127.0.0.1 --port 5214 --strictPort",
    "build": "bun run copy-fonts && vite build && node scripts/check-static-output.mjs",
    "start": "serve .output/public --config ../../serve.json",
    "preview": "vite preview",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:nav": "node scripts/check-doc-navigation.mjs",
    "lint:diagrams": "node scripts/check-doc-diagrams.mjs",
    "preview:diagram": "node scripts/render-diagram.mjs",
    "lint:links": "node scripts/check-doc-links.mjs && linkinator .output/public --config linkinator.config.json",
    "check": "bun run test:patterns && bun run lint:patterns && bun run test:docs && bun run lint:docs && bun run lint:terminology && bun run typecheck && bun run lint && bun run format:check && bun run lint:nav && bun run lint:diagrams && bun run build && bun run lint:links",
    "copy-fonts": "node scripts/copy-fonts.mjs",
    "lint:docs": "node scripts/check-doc-prose.mjs",
    "review:prose": "node scripts/check-doc-prose.mjs --review",
    "test:docs": "node --test scripts/doc-prose.test.mjs",
    "sync:terminology": "node scripts/keiro-terminology.mjs --refresh",
    "lint:terminology": "node scripts/keiro-terminology.mjs",
    "sync:patterns": "node scripts/runtime-patterns.mjs --refresh",
    "lint:patterns": "node scripts/runtime-patterns.mjs --check",
    "test:patterns": "node --test scripts/runtime-patterns.test.mjs agents/skills/doc-sync/status.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/start-static-server-functions": "1.167.39",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "1.4.2",
    "@types/hast": "^3.0.4",
    "@types/mdx": "2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "linkinator": "^6.1.2",
    "nitro": "3.0.260429-beta",
    "serve": "^14.2.6",
    "srvx": "^0.11.16",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ]
}
